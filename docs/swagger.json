    "definitions": {
        "dtos.CreateCustomerDTO": {
            "type": "object",
            "required": [
                "address",
                "city",
                "email",
                "name",
                "neighborhood",
                "number",
                "paymentDay",
                "phone",
                "state",
                "zipCode"
            ],
            "properties": {
                "address": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 10
                },
                "city": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 2
                },
                "complement": {
                    "type": "string",
                    "maxLength": 100
                },
                "email": {
                    "type": "string",
                    "maxLength": 255
                },
                "name": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3
                },
                "neighborhood": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 3
                },
                "number": {
                    "type": "string",
                    "maxLength": 10
                },
                "paymentDay": {
                    "type": "integer",
                    "maximum": 31,
                    "minimum": 1,
                    "example": 10
                },
                "phone": {
                    "type": "string"
                },
                "state": {
                    "type": "string"
                },
                "zipCode": {
                    "type": "string"
                }
            }
        },
        "dtos.CreateProductDTO": {
            "type": "object",
            "required": [
                "description"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "maxLength": 255,
                    "minLength": 3
                },
                "price": {
                    "type": "number",
                    "example": 10.5
                }
            }
        },
        "dtos.CreatePurchaseDTO": {
            "type": "object",
            "required": [
                "date",
                "products"
            ],
            "properties": {
                "date": {
                    "type": "string",
                    "example": "2025-10-13"
                },
                "paymentDate": {
                    "type": "string",
                    "example": "2025-10-13"
                },
                "products": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "required": [
                            "id",
                            "quantity"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "quantity": {
                                "type": "integer",
                                "minimum": 1
                            }
                        }
                    }
                }
            }
        },
